# Profil de deploiement "modele lent" pour le proxy LLM SSPCloud.
#
# Mesure le 2026-11-12 sur llm.lab.sspcloud.fr (qwen3-6-35b-moe) : environ
# 10 jetons/s, premier jeton en 1,2 s. Avec les defauts du pipeline, une
# recherche approfondie ne finissait pas en 1 200 s (2 sections sur 5). Avec
# ce profil : 885 s, 4 sections, 11 sources, 62 citations, aucune violation
# d'invariant (consigne : causes et consequences du declin des insectes en
# Europe depuis 1990).
#
# Ce profil retire du chemin critique des appels LLM qui ne redigent rien, et
# active la correction d'attribution RSS observee en production (le contenu
# du flux d'un site etait attribue a l'URL d'un article). Les trois premiers
# drapeaux changent la qualite de facon non mesuree : a trancher par les
# campagnes M2 et M5 (benchmarks/PROTOCOLE.md).
#
# Usage : `docker compose --env-file docker/profils/sspcloud-modele-lent.env ...`
# ou `set -a; . docker/profils/sspcloud-modele-lent.env; set +a` avant
# start_all.sh. Les requetes /research/deep doivent alors fixer timeout a 1200.

WEBTOOLS_PIPELINE_TARGETED_SEARCH_SKIP_STRUCTURED=1
WEBTOOLS_PIPELINE_SINGLE_LLM_PASS_ENABLED=0
WEBTOOLS_PIPELINE_ENRICHMENT_ENABLED=0
WEBTOOLS_PIPELINE_RSS_TIER_ROOT_ONLY=1
DEFAULT_LLM_STREAM=1
