# =============================================================================
# Configuration de webtools
# =============================================================================
# Copiez ce fichier en .env (ne le versionnez jamais) et remplissez les
# valeurs marquees OBLIGATOIRE. Une valeur commentee montre le defaut reel,
# defini dans app/core/config.py : ne la decommentez que pour la changer.
# docker-compose.yml et start_all.sh lisent les memes noms de variables.

# --- API ---------------------------------------------------------------------
# API_TITLE=WebTools API
# API_HOST=0.0.0.0
# API_PORT=8000
# LOG_LEVEL=INFO

# OBLIGATOIRE : cle de l'API REST (en-tete X-API-Key). Aussi utilisee par le
# serveur MCP pour joindre l'API.
WEBTOOLS_API_KEY=changez_moi

# --- LLM (compatible OpenAI, SSPCloud par defaut) -----------------------------
# Defauts uniques : app/core/config.py
# DEFAULT_LLM_PROVIDER=openai
# DEFAULT_LLM_MODEL=qwen3-6-35b-moe
# DEFAULT_LLM_BASE_URL=https://llm.lab.sspcloud.fr/api

# OBLIGATOIRE : cle du fournisseur LLM
DEFAULT_LLM_API_KEY=votre_cle_ici

# Autre fournisseur (exemples) :
# DEFAULT_LLM_PROVIDER=anthropic
# DEFAULT_LLM_MODEL=<modele Anthropic>
# DEFAULT_LLM_PROVIDER=albert
# DEFAULT_LLM_BASE_URL=https://albert.api.etalab.gouv.fr
# ALBERT_API_KEY=votre_cle_albert

# --- SearXNG -----------------------------------------------------------------
# URL de l'instance. Defaut : http://searxng:8080 (reseau docker-compose).
# start_all.sh la fixe a http://localhost:8081.
# SEARXNG_BASE_URL=http://searxng:8080

# OBLIGATOIRE : cle de session de SearXNG (ex. openssl rand -hex 32)
SEARXNG_SECRET=changez_moi
# OBLIGATOIRE : contact de l'exploitant, exige par les moteurs wikipedia et
# wikidata (URL ou mailto:)
SEARXNG_CONTACT_URL=mailto:votre_adresse
# Configuration des moteurs (start_all.sh ; docker-compose monte le dossier)
# SEARXNG_SETTINGS_PATH=docker/searxng/settings.yml

# --- Serveur MCP ---------------------------------------------------------------
# OBLIGATOIRE : jeton d'acces du serveur MCP
MCP_ACCESS_TOKEN=changez_moi
# MCP_PUBLIC_URL=http://localhost:8090
# URL de l'API vue du serveur MCP (docker-compose : http://webtools:8000)
# WEBTOOLS_API=http://localhost:8000
# WEBTOOLS_STATE_DIR=/tmp/webtools_state
# Domaine public du serveur MCP (etiquettes traefik de docker-compose.yml)
# MCP_PUBLIC_HOST=

# --- start_all.sh : interpreteurs (deux environnements Python distincts) ------
# API : dependances de requirements.lock ; MCP : requirements-mcp.lock
# WEBTOOLS_API_PYTHON=/chemin/vers/venv-api/bin/python
# WEBTOOLS_MCP_PYTHON=/chemin/vers/venv-mcp/bin/python
# SEARXNG_PYTHON=/chemin/vers/searxng-venv/bin/python

# --- Navigateur et extraction ----------------------------------------------------
# PLAYWRIGHT_HEADLESS=true
# PLAYWRIGHT_TIMEOUT=45000
# PLAYWRIGHT_BROWSERS_PATH=~/.cache/ms-playwright
# DEFAULT_EXTRACTION_TIMEOUT=45
# MAX_CONCURRENT_EXTRACTIONS=3

# Securite : ne jamais commiter .env ; renouveler les cles en cas de fuite.
